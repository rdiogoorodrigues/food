# Copiar para .env.local e preencher. Variáveis vazias são ignoradas.

# --- Login em modo local (sem Supabase) ---
# Gerar com: npm run hash-password -- diogo "a-minha-palavra-passe"
VITE_DIOGO_PASSWORD_HASH=
VITE_PARTNER_USERNAME=namorada
VITE_PARTNER_NAME=Namorada
VITE_PARTNER_PASSWORD_HASH=

# --- Sincronização entre telemóveis (recomendado) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DIOGO_EMAIL=
VITE_PARTNER_EMAIL=
